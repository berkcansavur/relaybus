    event.payload::text AS event_payload,
    event.headers::text AS event_headers,
    event.correlation_id AS event_correlation_id,
    event.causation_id AS event_causation_id,
    to_char(event.occurred_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS event_occurred_at
FROM "public"."relaybus_deliveries" AS delivery
JOIN "public"."relaybus_lanes" AS lane ON lane.lane = delivery.lane
JOIN "public"."relaybus_events" AS event ON event.id = delivery.event_id
WHERE (CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN 'processing' ELSE delivery.status END) = $1::text
ORDER BY delivery.created_at, delivery.id
LIMIT $2::int",
      },
      {
        "parameters": [
          "order.placed.v1",
          "e-1",
          "completed",
          100,
        ],
        "sql": "SELECT delivery.id AS delivery_id, delivery.handler,
  CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN 'processing' ELSE delivery.status END AS status,
  (delivery.attempts + CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN 1 ELSE 0 END)::int AS attempts,
  to_char(delivery.available_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS available_at,
  CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN lane.lease_owner END AS lease_owner,
  CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN to_char(lane.lease_expires_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') END AS lease_expires_at,
  delivery.last_error::text AS last_error,
  to_char(delivery.created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS created_at,
  to_char(delivery.updated_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS updated_at,
  to_char(delivery.completed_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS completed_at,
  event.id AS event_id,
    event.type AS event_type,
    event.source AS event_source,
    event.key AS event_key,
    event.payload::text AS event_payload,
    event.headers::text AS event_headers,
    event.correlation_id AS event_correlation_id,
    event.causation_id AS event_causation_id,
    to_char(event.occurred_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS event_occurred_at
FROM "public"."relaybus_deliveries" AS delivery
JOIN "public"."relaybus_lanes" AS lane ON lane.lane = delivery.lane
JOIN "public"."relaybus_events" AS event ON event.id = delivery.event_id
WHERE event.type = $1::text AND delivery.event_id = $2::text AND (CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN 'processing' ELSE delivery.status END) = $3::text
ORDER BY delivery.created_at, delivery.id
LIMIT $4::int",
      },
      {
        "parameters": [
          "h",
          "dead",
          3,
        ],
        "sql": "SELECT delivery.id AS delivery_id, delivery.handler,
  CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN 'processing' ELSE delivery.status END AS status,
  (delivery.attempts + CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN 1 ELSE 0 END)::int AS attempts,
  to_char(delivery.available_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS available_at,
  CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN lane.lease_owner END AS lease_owner,
  CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN to_char(lane.lease_expires_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') END AS lease_expires_at,
  delivery.last_error::text AS last_error,
  to_char(delivery.created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS created_at,
  to_char(delivery.updated_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS updated_at,
  to_char(delivery.completed_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS completed_at,
  event.id AS event_id,
    event.type AS event_type,
    event.source AS event_source,
    event.key AS event_key,
    event.payload::text AS event_payload,
    event.headers::text AS event_headers,
    event.correlation_id AS event_correlation_id,
    event.causation_id AS event_causation_id,
    to_char(event.occurred_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS event_occurred_at
FROM "public"."relaybus_deliveries" AS delivery
JOIN "public"."relaybus_lanes" AS lane ON lane.lane = delivery.lane
JOIN "public"."relaybus_events" AS event ON event.id = delivery.event_id
WHERE delivery.handler = $1::text AND (CASE WHEN (delivery.status = 'pending' AND delivery.id = ANY (lane.in_flight)) THEN 'processing' ELSE delivery.status END) = $2::text
ORDER BY delivery.created_at, delivery.id
LIMIT $3::int",
      },
    ],
    "oldestDue": "SELECT to_char(min(due.due_at) AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"') AS oldest_due_at FROM (
  SELECT waiting.available_at AS due_at
  FROM "public"."relaybus_lanes" AS lane
  CROSS JOIN LATERAL (
    SELECT delivery.available_at FROM "public"."relaybus_deliveries" AS delivery
    WHERE delivery.lane = lane.lane AND delivery.status = 'pending'
      AND delivery.available_at <= $1::timestamptz AND delivery.id <> ALL (lane.in_flight)
    ORDER BY delivery.available_at LIMIT 1
  ) AS waiting
  UNION ALL
  SELECT lane.lease_expires_at AS due_at
  FROM "public"."relaybus_lanes" AS lane
  WHERE lane.lease_expires_at <= $1::timestamptz AND NOT NOT EXISTS (
      SELECT 1 FROM unnest(lane.in_flight) AS flying (id)
      JOIN "public"."relaybus_deliveries" AS delivery ON delivery.id = flying.id AND delivery.status = 'pending'
    )
) AS due",
    "requeue": "WITH changed AS (WITH dead AS MATERIALIZED (
  SELECT delivery.id FROM "public"."relaybus_deliveries" AS delivery
  WHERE delivery.id = ANY (ARRAY(SELECT jsonb_array_elements_text($1::jsonb))) AND delivery.status = 'dead'
  ORDER BY delivery.id
  FOR NO KEY UPDATE
)
UPDATE "public"."relaybus_deliveries" AS delivery
SET status = 'pending', attempts = 0, available_at = $2::timestamptz, updated_at = $2::timestamptz
FROM dead
WHERE delivery.id = dead.id AND delivery.status = 'dead' RETURNING 1) SELECT count(*)::int AS count FROM changed",
  },
  "setup": {
    "schemaCurrent": "SELECT EXISTS (
  SELECT 1 FROM pg_catalog.pg_class AS c
  JOIN pg_catalog.pg_namespace AS n ON n.oid = c.relnamespace
  JOIN pg_catalog.pg_description AS d
    ON d.objoid = c.oid AND d.classoid = 'pg_catalog.pg_class'::regclass AND d.objsubid = 0
  WHERE n.nspname = 'public' AND c.relname = 'relaybus_lanes' AND d.description = $1::text
) AS current",
    "setupLock": "SELECT pg_advisory_xact_lock(hashtextextended($1::text, 0))",
    "setupLockKey": "relaybus:public",
  },
}
`;
