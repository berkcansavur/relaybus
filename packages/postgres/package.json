{
  "name": "@relaybus/postgres",
  "version": "0.0.0",
  "description": "PostgreSQL event store for relaybus: transactional outbox with SKIP LOCKED leasing, for pg, Prisma, TypeORM, Knex, Kysely and Drizzle.",
  "license": "MIT",
  "author": "Berkcan \u015eavur <berkcansavur@gmail.com>",
  "homepage": "https://github.com/berkcansavur/relaybus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkcansavur/relaybus.git",
    "directory": "packages/postgres"
  },
  "bugs": "https://github.com/berkcansavur/relaybus/issues",
  "keywords": [
    "relaybus",
    "event-bus",
    "outbox",
    "postgres",
    "postgresql",
    "outbox",
    "pg",
    "skip-locked"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "pg": "^8.11.0",
    "@relaybus/core": "workspace:^"
  },
  "devDependencies": {
    "@relaybus/core": "workspace:*",
    "@relaybus/testing": "workspace:*",
    "pg": "8.23.1",
    "@types/pg": "8.23.1",
    "@testcontainers/postgresql": "12.2.1",
    "testcontainers": "12.2.1",
    "kysely": "0.29.7",
    "knex": "3.3.0",
    "typeorm": "1.1.2",
    "drizzle-orm": "0.45.4"
  }
}
