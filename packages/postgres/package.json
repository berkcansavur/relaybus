{
  "name": "@relaybus/postgres",
  "version": "0.0.0",
  "description": "PostgreSQL event store for relaybus: a transactional outbox written in your own transaction (pg, Prisma, TypeORM, Drizzle, Knex, Kysely) with SKIP LOCKED leasing and per-key ordering.",
  "license": "MIT",
  "author": "Berkcan Şavur <berkcansavur@gmail.com>",
  "homepage": "https://berkcansavur.github.io/relaybus/packages/postgres",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkcansavur/relaybus.git",
    "directory": "packages/postgres"
  },
  "bugs": "https://github.com/berkcansavur/relaybus/issues",
  "keywords": [
    "relaybus",
    "postgres",
    "postgresql",
    "postgres-queue",
    "pg",
    "prisma",
    "typeorm",
    "drizzle",
    "knex",
    "kysely",
    "skip-locked",
    "transactional-outbox",
    "outbox-pattern",
    "outbox",
    "event-bus",
    "event-driven",
    "reliable-events",
    "at-least-once",
    "exactly-once",
    "dead-letter-queue"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./kysely": {
      "import": {
        "types": "./dist/kysely.d.ts",
        "default": "./dist/kysely.js"
      },
      "require": {
        "types": "./dist/kysely.d.cts",
        "default": "./dist/kysely.cjs"
      }
    },
    "./knex": {
      "import": {
        "types": "./dist/knex.d.ts",
        "default": "./dist/knex.js"
      },
      "require": {
        "types": "./dist/knex.d.cts",
        "default": "./dist/knex.cjs"
      }
    },
    "./typeorm": {
      "import": {
        "types": "./dist/typeorm.d.ts",
        "default": "./dist/typeorm.js"
      },
      "require": {
        "types": "./dist/typeorm.d.cts",
        "default": "./dist/typeorm.cjs"
      }
    },
    "./drizzle": {
      "import": {
        "types": "./dist/drizzle.d.ts",
        "default": "./dist/drizzle.js"
      },
      "require": {
        "types": "./dist/drizzle.d.cts",
        "default": "./dist/drizzle.cjs"
      }
    },
    "./prisma": {
      "import": {
        "types": "./dist/prisma.d.ts",
        "default": "./dist/prisma.js"
      },
      "require": {
        "types": "./dist/prisma.d.cts",
        "default": "./dist/prisma.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@relaybus/core": "workspace:^",
    "drizzle-orm": ">=0.36.0",
    "knex": ">=3.0.0",
    "kysely": ">=0.27.0",
    "pg": "^8.11.0",
    "typeorm": ">=0.3.0",
    "@prisma/client": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@relaybus/core": "workspace:*",
    "@relaybus/testing": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.4",
    "knex": "3.3.0",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "relaybus-postgres-0.4.0": "npm:@relaybus/postgres@0.4.0",
    "testcontainers": "12.2.1",
    "typeorm": "1.1.2"
  },
  "typesVersions": {
    "*": {
      "kysely": [
        "dist/kysely.d.ts"
      ],
      "knex": [
        "dist/knex.d.ts"
      ],
      "typeorm": [
        "dist/typeorm.d.ts"
      ],
      "drizzle": [
        "dist/drizzle.d.ts"
      ],
      "prisma": [
        "dist/prisma.d.ts"
      ]
    }
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "knex": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    }
  }
}
