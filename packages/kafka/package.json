{
  "name": "@relaybus/kafka",
  "version": "0.0.0",
  "description": "Apache Kafka transport for relaybus: publish committed events to topics and consume them with idempotent inbox semantics.",
  "license": "MIT",
  "author": "Berkcan \u015eavur <berkcansavur@gmail.com>",
  "homepage": "https://github.com/berkcansavur/relaybus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkcansavur/relaybus.git",
    "directory": "packages/kafka"
  },
  "bugs": "https://github.com/berkcansavur/relaybus/issues",
  "keywords": [
    "relaybus",
    "event-bus",
    "outbox",
    "kafka",
    "kafkajs",
    "confluent",
    "transport"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@relaybus/core": "workspace:^"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@relaybus/core": "workspace:*",
    "@relaybus/testing": "workspace:*",
    "kafkajs": "2.2.4",
    "@testcontainers/kafka": "12.2.1",
    "testcontainers": "12.2.1"
  }
}
