{
  "name": "@relaybus/kafka",
  "version": "0.0.0",
  "description": "Kafka transport for relaybus: forwards committed outbox events to Kafka topics (CloudEvents binding) and consumes them with an idempotent inbox, so events are not lost between database and Kafka.",
  "license": "MIT",
  "author": "Berkcan Şavur <berkcansavur@gmail.com>",
  "homepage": "https://berkcansavur.github.io/relaybus/packages/kafka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkcansavur/relaybus.git",
    "directory": "packages/kafka"
  },
  "bugs": "https://github.com/berkcansavur/relaybus/issues",
  "keywords": [
    "relaybus",
    "kafka",
    "kafkajs",
    "apache-kafka",
    "kafka-outbox",
    "kafka-consumer",
    "kafka-producer",
    "confluent",
    "cloudevents",
    "transactional-outbox",
    "outbox-pattern",
    "inbox-pattern",
    "event-driven",
    "event-bus",
    "reliable-events",
    "at-least-once",
    "idempotent-consumer",
    "dead-letter-queue",
    "nestjs",
    "microservices"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@relaybus/core": "workspace:^",
    "kafkajs": "^2.2.4",
    "@confluentinc/kafka-javascript": "^1.11.0"
  },
  "peerDependenciesMeta": {
    "kafkajs": {
      "optional": true
    },
    "@confluentinc/kafka-javascript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@relaybus/core": "workspace:*",
    "@relaybus/testing": "workspace:*",
    "kafkajs": "2.2.4",
    "@testcontainers/kafka": "12.2.1",
    "testcontainers": "12.2.1",
    "@confluentinc/kafka-javascript": "1.11.0"
  }
}
