{
  "name": "@relaybus/testing",
  "version": "0.1.0",
  "description": "Test utilities for relaybus: the EventStore contract suite, a fake clock and an in-memory transport.",
  "license": "MIT",
  "author": "Berkcan Şavur <berkcansavur@gmail.com>",
  "homepage": "https://github.com/berkcansavur/relaybus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkcansavur/relaybus.git",
    "directory": "packages/testing"
  },
  "bugs": "https://github.com/berkcansavur/relaybus/issues",
  "keywords": [
    "relaybus",
    "testing",
    "contract-tests",
    "event-bus"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@relaybus/core": "workspace:^",
    "vitest": ">=3.0.0"
  },
  "devDependencies": {
    "@relaybus/core": "workspace:*"
  }
}
