{
  "name": "@relaybus/testing",
  "version": "0.0.0",
  "description": "Testing utilities for relaybus: the EventStore contract suite, a FakeClock and an in-memory transport for deterministic tests of retries, delays and dead letters, and a codec contract that runs under Vitest, Jest or any other test framework.",
  "license": "MIT",
  "author": "Berkcan Şavur <berkcansavur@gmail.com>",
  "homepage": "https://berkcansavur.github.io/relaybus/packages/testing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkcansavur/relaybus.git",
    "directory": "packages/testing"
  },
  "bugs": "https://github.com/berkcansavur/relaybus/issues",
  "keywords": [
    "relaybus",
    "testing",
    "test-utilities",
    "contract-tests",
    "fake-clock",
    "in-memory",
    "vitest",
    "jest",
    "event-bus",
    "transactional-outbox",
    "outbox-pattern",
    "event-driven",
    "reliable-events",
    "dead-letter-queue",
    "retry",
    "nestjs",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./codec-contract": {
      "import": {
        "types": "./dist/codec-contract.d.ts",
        "default": "./dist/codec-contract.js"
      },
      "require": {
        "types": "./dist/codec-contract.d.cts",
        "default": "./dist/codec-contract.cjs"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/jest.d.ts",
        "default": "./dist/jest.js"
      },
      "require": {
        "types": "./dist/jest.d.cts",
        "default": "./dist/jest.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@relaybus/core": "workspace:^",
    "vitest": ">=3.0.0"
  },
  "devDependencies": {
    "@relaybus/core": "workspace:*"
  },
  "typesVersions": {
    "*": {
      "codec-contract": [
        "dist/codec-contract.d.ts"
      ],
      "jest": [
        "dist/jest.d.ts"
      ]
    }
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
