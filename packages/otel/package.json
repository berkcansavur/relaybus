{
  "name": "@relaybus/otel",
  "version": "0.0.0",
  "description": "OpenTelemetry for relaybus: messaging metrics after the semantic conventions, outbox backlog gauges, and one trace from publish in one service to the handler in another, with W3C trace context in event headers.",
  "license": "MIT",
  "author": "Berkcan Şavur <berkcansavur@gmail.com>",
  "homepage": "https://berkcansavur.github.io/relaybus/packages/otel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkcansavur/relaybus.git",
    "directory": "packages/otel"
  },
  "bugs": "https://github.com/berkcansavur/relaybus/issues",
  "keywords": [
    "relaybus",
    "opentelemetry",
    "otel",
    "tracing",
    "metrics",
    "observability",
    "w3c-trace-context",
    "traceparent",
    "transactional-outbox",
    "outbox-pattern",
    "event-bus",
    "nestjs",
    "kafka",
    "rabbitmq"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0",
    "@relaybus/core": "workspace:^"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@relaybus/core": "workspace:*",
    "@relaybus/rabbitmq": "workspace:*",
    "@relaybus/testing": "workspace:*"
  }
}
