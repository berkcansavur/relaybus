{
  "name": "@relaybus/rabbitmq",
  "version": "0.0.0",
  "description": "RabbitMQ transport for relaybus: publisher-confirmed publishing from the transactional outbox and acknowledged, idempotent consumption with retry queues and dead-letter queues.",
  "license": "MIT",
  "author": "Berkcan \u015eavur <berkcansavur@gmail.com>",
  "homepage": "https://berkcansavur.github.io/relaybus/packages/rabbitmq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkcansavur/relaybus.git",
    "directory": "packages/rabbitmq"
  },
  "bugs": "https://github.com/berkcansavur/relaybus/issues",
  "keywords": [
    "relaybus",
    "rabbitmq",
    "amqp",
    "amqplib",
    "rabbitmq-outbox",
    "publisher-confirms",
    "quorum-queues",
    "transactional-outbox",
    "outbox-pattern",
    "inbox-pattern",
    "event-driven",
    "event-bus",
    "reliable-events",
    "message-bus",
    "at-least-once",
    "idempotent-consumer",
    "dead-letter-queue",
    "retry",
    "nestjs",
    "microservices"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "amqplib": ">=0.10.0",
    "@relaybus/core": "workspace:^"
  },
  "devDependencies": {
    "@relaybus/core": "workspace:*",
    "@relaybus/testing": "workspace:*",
    "amqplib": "2.2.0",
    "@types/amqplib": "0.10.8",
    "@testcontainers/rabbitmq": "12.2.1",
    "testcontainers": "12.2.1"
  }
}
