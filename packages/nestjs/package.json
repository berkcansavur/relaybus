{
  "name": "@relaybus/nestjs",
  "version": "0.0.0",
  "description": "NestJS event bus module for relaybus: @RelayBusHandler handlers on a transactional outbox, with retries, dead letters and graceful shutdown, so events are never lost between your database and your handlers.",
  "license": "MIT",
  "author": "Berkcan \u015eavur <berkcansavur@gmail.com>",
  "homepage": "https://berkcansavur.github.io/relaybus/packages/nestjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkcansavur/relaybus.git",
    "directory": "packages/nestjs"
  },
  "bugs": "https://github.com/berkcansavur/relaybus/issues",
  "keywords": [
    "relaybus",
    "nestjs",
    "nestjs-event-bus",
    "nestjs-microservices",
    "nestjs-outbox",
    "nestjs-events",
    "event-bus",
    "event-driven",
    "transactional-outbox",
    "outbox-pattern",
    "domain-events",
    "reliable-events",
    "message-bus",
    "at-least-once",
    "idempotent-consumer",
    "dead-letter-queue",
    "retry",
    "decorator",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0",
    "@relaybus/core": "workspace:^"
  },
  "devDependencies": {
    "@relaybus/core": "workspace:*",
    "@relaybus/testing": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/testing": "12.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
