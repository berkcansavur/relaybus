{
  "name": "@relaybus/core",
  "version": "0.1.0",
  "description": "Reliable, storage-agnostic event bus: transactional outbox, per-handler deliveries, retries with jitter, dead letters and ordering keys.",
  "license": "MIT",
  "author": "Berkcan Şavur <berkcansavur@gmail.com>",
  "homepage": "https://github.com/berkcansavur/relaybus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkcansavur/relaybus.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/berkcansavur/relaybus/issues",
  "keywords": [
    "event-bus",
    "outbox",
    "transactional-outbox",
    "inbox",
    "events",
    "retry",
    "dead-letter",
    "nestjs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  }
}
