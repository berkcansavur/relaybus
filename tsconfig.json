{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@relaybus/core": ["./packages/core/src/index.ts"],
      "@relaybus/nestjs": ["./packages/nestjs/src/index.ts"],
      "@relaybus/postgres": ["./packages/postgres/src/index.ts"],
      "@relaybus/mongodb": ["./packages/mongodb/src/index.ts"],
      "@relaybus/kafka": ["./packages/kafka/src/index.ts"],
      "@relaybus/rabbitmq": ["./packages/rabbitmq/src/index.ts"],
      "@relaybus/testing": ["./packages/testing/src/index.ts"]
    }
  },
  "include": [
    "./packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "test-support/**/*.ts",
    "vitest.config.ts",
    "vitest.global-setup.ts",
    "vitest.provided.d.ts",
    "examples/**/*.ts"
  ]
}
