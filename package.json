{
  "name": "relaybus-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p benchmarks/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --project integration-serial",
    "test:affected": "vitest run --changed",
    "test:pull-images": "node scripts/pull-test-images.mjs",
    "coverage": "vitest run --coverage",
    "bench:quick": "node benchmarks/cli.ts quick",
    "bench:full": "node benchmarks/cli.ts full",
    "mutation": "stryker run",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "prepare": "husky && node scripts/generate-test-prisma-client.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22",
    "@vitest/coverage-v8": "5.0.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "semantic-release": "25.0.9",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "patchedDependencies": {
      "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator__vitest-runner@10.0.0.patch"
    },
    "onlyBuiltDependencies": [
      "@confluentinc/kafka-javascript"
    ]
  }
}
